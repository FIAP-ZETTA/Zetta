# .env.example — COPIE ESTE ARQUIVO PARA .env E PREENCHA OS VALORES
# NUNCA commite o arquivo .env no GitHub!
#
# Como usar:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#   (edite o .env com seus valores reais)

# ── Gemini / Google AI ────────────────────────────────────────────────────────
# Habilita a IA de remediação do ZettaScan e a Camada 2 (classificação semântica) do ZettaGuard.
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── URLs de Comunicação dos Serviços ──────────────────────────────────────────
# Frontend -> Backends (Portas padrões)
NEXT_PUBLIC_ZETTASCAN_URL=http://localhost:8000
NEXT_PUBLIC_ZETTAGUARD_URL=http://localhost:8002

# Portas dos Serviços
ZETTASCAN_PORT=8000
ZETTAGUARD_PORT=8002
ZETTADASH_PORT=3000

# Docker Network URLs Internas (usadas pelo container do Next.js)
ZETTASCAN_INTERNAL_URL=http://zettascan:8000
ZETTAGUARD_INTERNAL_URL=http://zettaguard:8002
